# Local/test override for JMAP credentials, read by sync-contacts and
# sync-calendar. Optional: if JMAP_API_KEY is unset, both functions fall
# back to company_settings.jmap_endpoint / jmap_secret_id (resolved via
# Supabase Vault) exactly as they did before -- this is purely additive,
# not a replacement for that path, and does not touch the Settings UI.
#
# Copy to `.env` (gitignored) and fill in real values for local
# `supabase functions serve --env-file supabase/functions/.env`, or
# `supabase secrets set --env-file supabase/functions/.env` to push to a
# deployed project.

# Base URL of the Stalwart instance, e.g. https://stalwart.ecke.solutions
JMAP_ENDPOINT=

# Human-readable context only -- not used to authenticate (Bearer auth
# doesn't need a username), see JMAP_API_KEY.
JMAP_USERNAME=

# A Stalwart API Key secret (see https://stalw.art/docs/ref/object/api-key/),
# sent as `Authorization: Bearer <value>`. Not an account password.
JMAP_API_KEY=
