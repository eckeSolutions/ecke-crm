# Env file for the local self-hosted Supabase stack (docker-compose.yml in
# this directory) -- Postgres, GoTrue, PostgREST, Kong, Studio, and the
# seed accounts used for local dev login (see README.md#local-dev-login).
#
# Copy to `.env` (gitignored) in this same directory before running
# `docker compose up`. This is NOT the same file as
# `supabase/functions/.env.example` -- that one is only for the JMAP sync
# Edge Functions and has nothing to do with the Supabase stack itself.

# --- POSTGRES ---
POSTGRES_PASSWORD=postgres
DB_PASSWORD=postgres
DB_HOST=supabase-db
DB_PORT=5432

# --- AUTH ---
# ⚠️ LOCAL DEV ONLY. These are the well-known Supabase demo values (published in
# Supabase's own docs/repo). They are safe ONLY on localhost. Before any deployment
# (including a shared dev/staging Coolify instance), regenerate all four:
#   openssl rand -base64 48   # -> JWT_SECRET
#   Then mint ANON_KEY / SERVICE_ROLE_KEY as JWTs signed with that secret
#   (role: anon / service_role, see supabase/cli `gen keys` or https://supabase.com/docs/guides/self-hosting/docker#api-keys)
# Anyone who has these exact demo values can forge a valid service_role JWT against
# ANY self-hosted Supabase instance still using them — this is a known mass-scan target.
JWT_SECRET=<openssl rand -base64 48>
ANON_KEY=<jwt signed with JWT_SECRET, payload role=anon>
SERVICE_ROLE_KEY=<jwt signed with JWT_SECRET, payload role=service_role>
# 64+ char random base — used to sign Realtime's internal session cookies
REALTIME_SECRET_KEY_BASE=<openssl rand -base64 48>

# --- SEED ADMIN (local dev only) ---
# Test-data account for this machine's Supabase volume, created via the
# signup curl in docs/DEPLOYMENT.md. Not read by any service automatically —
# purely a place to record it instead of hardcoding it in a tracked file.
# If the volume is wiped and the account recreated, update these to match.
SEED_ADMIN_EMAIL=admin@ecke.solutions
SEED_ADMIN_PASSWORD=<set after creating the account>
# Kleinunternehmer = one person. This is NOT a second staff member — it's
# your own least-privilege daily-driver login (time tracking, draft
# invoices), kept separate from the admin account (settings, billing,
# full financial visibility) so day-to-day use isn't running as admin.
SEED_EMPLOYEE_EMAIL=mitarbeiter@ecke.solutions
SEED_EMPLOYEE_PASSWORD=<set after creating the account>

# --- STUDIO / DASHBOARD ---
# Basic-auth gate enforced by Kong in front of Studio (see kong.yml) — Studio
# itself has no login of its own, this is the only thing standing in front
# of it. LOCAL DEV DEFAULTS — regenerate before any shared/deployed env.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=<pick a local password>

# --- SITE ---
SITE_URL=http://localhost:3000
API_EXTERNAL_URL=http://localhost:8000

# --- GOTRUE / AUTH ---
GOTRUE_EXTERNAL_URL=http://localhost:8000/auth/v1
GOTRUE_DB_DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@supabase-db:5432/postgres
GOTRUE_SITE_URL=${SITE_URL}
GOTRUE_JWT_SECRET=${JWT_SECRET}
GOTRUE_JWT_EXP=3600
GOTRUE_MAILER_AUTOCONFIRM=true

# --- PORTGREST ---
PGRST_DB_URI=postgres://postgres:${POSTGRES_PASSWORD}@supabase-db:5432/postgres
PGRST_DB_SCHEMAS=public,storage,graphql_public,vault
PGRST_JWT_SECRET=${JWT_SECRET}

# --- KONG ---
KONG_HTTP_PORT=8000

# --- STUDIO ---
# Studio has no host port of its own anymore — it's only reachable through
# Kong at SUPABASE_PUBLIC_URL, behind the basic-auth gate above.
SUPABASE_PUBLIC_URL=http://localhost:8000

# --- EDGE FUNCTIONS (supabase-edge-functions service) ---
# JWT_SECRET / ANON_KEY / SERVICE_ROLE_KEY above are reused by the runtime.
# Optional local/test override for the JMAP sync functions (sync-contacts,
# sync-calendar). Leave unset to use company_settings.jmap_* + Supabase Vault
# (the production path). See supabase/functions/.env.example for details.
JMAP_ENDPOINT=
JMAP_USERNAME=
JMAP_API_KEY=
